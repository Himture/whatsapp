# All optional — the app runs fully in local mode (IndexedDB) without any of these.
# Copy to .env.local and fill in only what you need for cloud sync / hosted mode.

# PostgreSQL connection string (Neon, Supabase, Railway, or any Postgres)
DATABASE_URL=

# Session signing key — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Application base URL
BETTER_AUTH_URL=http://localhost:3000

# Server-side token encryption key — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Public GitHub repo URL shown in the marketing CTAs (defaults to the project repo)
NEXT_PUBLIC_GITHUB_URL=https://github.com/Himture/whatsapp

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
